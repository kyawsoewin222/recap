# AI_PROVIDER: "auto" (default), "agy" (Antigravity CLI), or "gemini" (Gemini API key).
# In "auto" mode, uses GEMINI_API_KEY if set, otherwise falls back to local agy CLI.
AI_PROVIDER="auto"

# GEMINI_API_KEY: Required when AI_PROVIDER="gemini"; optional when using agy CLI.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Antigravity CLI settings (used when AI_PROVIDER="agy" or in "auto" fallback)
AGY_BIN="agy"
AGY_TEXT_MODEL="gemini-4-hydrogen-medium"
AGY_VIDEO_MODEL="gemini-4-argon-medium"

# Gemini API model overrides (used when AI_PROVIDER="gemini")
GEMINI_TEXT_MODEL="gemini-4-hydrogen"
GEMINI_VIDEO_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
